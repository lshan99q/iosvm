+/* ---- the Today view, built again at every layout of the icon model ------------------------------- */
+
+/*
+ * -[SBIconController _rootFolderDidChange] is what has SpringBoard build its Today page: for the home
+ * screen (location 1) and for the cover sheet (location 2) it asks
+ * -[SBIconController _newTodayViewControllerWithIconManager:iconListModel:rootFolder:location:], whose
+ * answer's -[SBTodayViewController loadView] sets up the Spotlight presenter, whose feather blur warms
+ * up MTMaterialView -- and there, under QEMU, all four cores are busy for a second and more (the hot
+ * stack of the tenth stage; qemu/symstack.py names its addresses).
+ * Where the calls come from, in Darwin userland 16.5 (20F66; SpringBoard's own code, read out of the
+ * shared cache with `ipsw dyld` and llvm-objdump; addresses unslid):
+ *   -[SBIconController setModel:] + 0x1b8 (0x1c4bed5ac), right after [model rootFolder] answered
+ *       something (the call sits behind a nil check): one rebuild per icon model installed, and the
+ *       model is installed by -[SBIconController _updateIconModelStore] (0x1c4bed38c), which
+ *       -[SBIconController initWithMainDisplayWindowScene:...] calls at +0x2d4 -- at every boot.
+ *   -[SBIconController _iconModelDidLayout:] (0x1c4bed95c) is one instruction, `b
+ *       _objc_msgSend$_rootFolderDidChange`: the observer -[SBIconController setModel:] registers
+ *       (+0x198, 0x1c4bed58c) for SBIconModelDidLayoutIconStateNotification, posted every time the
+ *       icon model lays its state out -- after the icons are read back, and after an icon list change.
+ * So the Today page is built because the icon state was loaded and laid out, not because Spotlight
+ * starts: the Spotlight presenter is set up from inside the Today page's loadView, a passenger.
+ * -[SBIconController _makeTodayViewControllers] (+0x7c and +0xd4, 0x1c4bf05e0 and 0x1c4bf0638) asks for
+ * the same view controllers, but only where their ivars are nil: it is where a boot gets one built
+ * when setModel:'s call had no root folder to work with.
+ *
+ * Boot arguments (without one of them nothing is replaced, so an ordinary boot runs SpringBoard's own
+ * code and pays nothing for this):
+ *   today_log=1    a line for every call of either method -- time since the kernel booted, which call
+ *                  it is, the thread. One boot then answers how many times the page is rebuilt.
+ *   today_light=1  the view controller is not made (the factory answers nil): the expensive half,
+ *                  loadView and the search presenter and the blur and MTMaterialView's start-up, does
+ *                  not happen, while the rest of _rootFolderDidChange (the default Today layout, the
+ *                  widget suggestion upgrade, the do-not-disturb state) still does.
+ *   today_off=1    _rootFolderDidChange answers without doing anything at all, and the factory answers
+ *                  nil for everyone: no Today page ever exists (the home screen still lays out; the
+ *                  Today page is empty if it is swiped to, and the cover sheet has none).
+ */
+
+#define TODAY_AS_IT_IS  0
+#define TODAY_LIGHT     1       /* the page is not built; everything else about it is */
+#define TODAY_OFF       2       /* nothing of it is done */
+
+static IMP original_root_folder_did_change;
+static IMP original_new_today_view_controller;
+static int today_mode = TODAY_AS_IT_IS;
+static bool today_logs;
+
+static uint64_t
+milliseconds_since_boot(void)
+{
+	static mach_timebase_info_data_t base;
+
+	if (base.denom == 0) {
+		mach_timebase_info(&base);
+	}
+	return mach_absolute_time() * base.numer / base.denom / 1000000;
+}
+
+/* the value of NAME= among the arguments the kernel was given (kern.bootargs), or NULL */
+static const char *
+boot_argument_value(const char *arguments, const char *name)
+{
+	size_t length = strlen(name);
+	const char *argument = arguments;
+
+	while ((argument = strstr(argument, name)) != NULL) {
+		if ((argument == arguments || argument[-1] == ' ') && argument[length] == '=') {
+			return argument + length + 1;
+		}
+		argument++;
+	}
+	return NULL;
+}
+
+static void
+root_folder_did_change(id self, SEL selector)
+{
+	static unsigned calls;
+
+	calls++;
+	if (today_logs) {
+		say("hakios: today: _rootFolderDidChange #%u%s (%llu ms since boot, %s)\n", calls,
+		    calls == 1 ? ", the first of this boot" : "", milliseconds_since_boot(),
+		    pthread_main_np() ? "the main thread" : "NOT the main thread");
+	}
+	if (today_mode == TODAY_OFF) {
+		return;
+	}
+	((void (*)(id, SEL))original_root_folder_did_change)(self, selector);
+}
+
+static id
+new_today_view_controller(id self, SEL selector, id icon_manager, id icon_list_model, id root_folder, long location)
+{
+	static unsigned calls;
+
+	calls++;
+	if (today_logs) {
+		say("hakios: today: the Today view is built, #%u (location %ld%s, %llu ms since boot, %s)\n", calls,
+		    location, today_mode == TODAY_AS_IT_IS ? "" : ", not here", milliseconds_since_boot(),
+		    pthread_main_np() ? "the main thread" : "NOT the main thread");
+	}
+	if (today_mode != TODAY_AS_IT_IS) {
+		return nil;
+	}
+	return ((id (*)(id, SEL, id, id, id, long))original_new_today_view_controller)(self, selector, icon_manager,
+	    icon_list_model, root_folder, location);
+}
+
+static void
+watch_today(void)
+{
+	char arguments[1024] = "";
+	size_t size = sizeof(arguments) - 1;
+	const char *value;
+
+	if (sysctlbyname("kern.bootargs", arguments, &size, NULL, 0) != 0) {
+		return;
+	}
+	if ((value = boot_argument_value(arguments, "today_off")) != NULL && value[0] == '1') {
+		today_mode = TODAY_OFF;
+	}
+	if ((value = boot_argument_value(arguments, "today_light")) != NULL && value[0] == '1' &&
+	    today_mode != TODAY_OFF) {
+		today_mode = TODAY_LIGHT;
+	}
+	if ((value = boot_argument_value(arguments, "today_log")) != NULL && value[0] == '1') {
+		today_logs = true;
+	}
+	if (today_mode == TODAY_AS_IT_IS && !today_logs) {
+		return;         /* nothing asked for: the Today page is SpringBoard's own */
+	}
+	original_root_folder_did_change = replace_method("SBIconController", "_rootFolderDidChange", 0x1c4befa68UL,
+	    (IMP)root_folder_did_change);
+	original_new_today_view_controller = replace_method("SBIconController",
+	    "_newTodayViewControllerWithIconManager:iconListModel:rootFolder:location:", 0x1c4bf74bcUL,
+	    (IMP)new_today_view_controller);
+	say("hakios: today: %s; _rootFolderDidChange %s, _newTodayViewController... %s\n",
+	    today_mode == TODAY_OFF ? "nothing of the Today page is done (today_off=1)" :
+	    today_mode == TODAY_LIGHT ? "the Today view controller is not made (today_light=1)" :
+	    "the Today page as SpringBoard has it",
+	    original_root_folder_did_change ? "hooked" : "NOT hooked",
+	    original_new_today_view_controller ? "hooked" : "NOT hooked");
+}
