+/*
+ * Registration from inside SpringBoard.
+ *
+ * LaunchServices answers a plain tool with silence: the workspace is built, the proxy for the
+ * bundle comes back, and registerApplication: is never answered (docs/research, addendum 34a).
+ * SpringBoard is an application the system trusts, and it is the process that ends up drawing the
+ * home screen, so the same call is worth making from here -- a minute in, when lsd has a database
+ * to talk about.
+ */
+static void
+register_test_app(void)
+{
+	Class workspace_class = objc_getClass("LSApplicationWorkspace");
+	Class proxy_class = objc_getClass("LSApplicationProxy");
+	const char *path = "/Applications/TestApp.app";
+	id workspace, proxy, list;
+	CFURLRef url;
+	BOOL registered;
+	long known = -1;
+
+	if (workspace_class == NULL || proxy_class == NULL) {
+		say("hakios: register: LaunchServices classes are not here\n");
+		return;
+	}
+	workspace = ((id (*)(id, SEL))objc_msgSend)((id)workspace_class,
+	    sel_registerName("defaultWorkspace"));
+	if (workspace == NULL) {
+		say("hakios: register: no workspace\n");
+		return;
+	}
+	list = ((id (*)(id, SEL))objc_msgSend)(workspace, sel_registerName("allApplications"));
+	if (list != NULL) {
+		known = (long)((unsigned long (*)(id, SEL))objc_msgSend)(list, sel_registerName("count"));
+	}
+	say("hakios: register: SpringBoard sees %ld applications\n", known);
+	url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)path, strlen(path), true);
+	proxy = ((id (*)(id, SEL, CFURLRef))objc_msgSend)((id)proxy_class,
+	    sel_registerName("applicationProxyForBundleURL:"), url);
+	say("hakios: register: proxy %p for %s\n", (void *)proxy, path);
+	registered = ((BOOL (*)(id, SEL, id))objc_msgSend)(workspace,
+	    sel_registerName("registerApplication:"), proxy);
+	say("hakios: register: registerApplication: -> %d\n", (int)registered);
+	list = ((id (*)(id, SEL))objc_msgSend)(workspace, sel_registerName("allApplications"));
+	if (list != NULL) {
+		known = (long)((unsigned long (*)(id, SEL))objc_msgSend)(list, sel_registerName("count"));
+	}
+	say("hakios: register: SpringBoard now sees %ld applications\n", known);
+}
