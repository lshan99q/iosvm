# The GL calls QuartzCore makes, and the types they carry across the wire.
#
# Taken from userland/src/eagl_slots.txt: the entries marked `*` are the ones QuartzCore's OpenGL ES
# renderer drives, 62 of them. Everything else in the table is for other callers and does not need
# to cross the boundary for the interface to draw.
#
# Format: name(argtype, argtype, ...) [-> returntype] [!local]
#
# The argument list is the *real GL signature*: a trampoline that overrides an EAGL table slot is
# called with exactly these arguments, so it must not invent a size parameter (an earlier version
# did, and read a garbage register for the pointer arguments).
#
# Scalars
#   E    GLenum (u32)         I    GLint (i32)          F  GLfloat
#   U    GLuint (u32)         S    GLsizei (i32)        B  GLboolean (u8)
#
# Pointers, each with its own way of knowing how many bytes it is
#   s    NUL-terminated string            -> u32 length + bytes
#   v    vertex-array pointer             -> no bytes here; the arrays travel with the draw (opcode 200)
#   d    index array (glDrawElements)     -> a1 (count) * sizeof(a2)
#   x    texture pixels                   -> a3 x a4, format a6, type a7
#   y    sub-texture pixels               -> a4 x a5, format a6, type a7
#   z    compressed pixels                -> a6 bytes
#   t    texture-name array               -> a0 * 4
#   r    framebuffer-name array           -> a0 * 4
#   g    glGetIntegerv's output           -> no bytes: the host answers with its own state
#   q    GLsync (an opaque pointer)       -> 8 bytes
#   3    3-float uniform array            -> a1 * 12
#   4    4-float uniform array            -> a1 * 16
#   m    3x3 matrix array                 -> a1 * 36
#   M    4x4 matrix array                 -> a1 * 64
#   V    glShaderSource's two pointers    -> a1 strings, each with its length (a3, or strlen)
#
# Return values
#   E/U/I are appended to the record after the arguments: the guest's local call has already
#   answered them, and the host uses them to learn the guest's object names.
#   q is appended as 8 bytes (glFenceSync's guest GLsync).
#   P is a C pointer the host answers for itself (glGetString); nothing is appended.
#
# !local: the host draws the frame with this call, so it is not run on the guest as well (gen.py
# wraps the local call in `if (!remote_only)`, eagl_remote.c decides). Which calls can be marked:
#
#   - everything that executes pixels here -- a texture upload, a sub-upload, a compressed upload,
#     a copy out of the framebuffer, a mipmap build, a draw, a clear. Mesa's software rasteriser
#     under TCG spends the whole frame on these, and the host has the same pixels by reference.
#   - every piece of GL state only that drawing reads (blend, scissor, viewport, enable/disable,
#     the uniform vectors, the vertex arrays, the bound texture, the framebuffer binding).
#   - glBindTexture: not for the cost of the call, but because eagl.c's wrapper of it refills the
#     texture from its IOSurface (surface_to_texture, 108 ms a frame on a 750x1624 panel).
#
# What stays local is what answers something the record cannot carry:
#
#   - the names glGenTextures, glGenFramebuffers, glCreateShader, glCreateProgram, glFenceSync and
#     glGetUniformLocation return, which the host maps to its own objects (names.h).
#   - the state and strings glGetIntegerv, glGetString and glGetError answer to CoreAnimation.
#   - glFlush and glFinish, which are where eagl.c decides a frame has ended (frame_end()).
#   - the deletes, which have to happen in the guest's own bookkeeping too.
#   - glCompileShader, glLinkProgram, glAttachShader, glBindAttribLocation and glShaderSource:
#     kept for now, they run once and their diagnostics are useful (the host reports a failure).

glAlphaFunc(E, F) !local
glBindTexture(E, U) !local
glBlendFunc(E, E) !local
glBlendFuncSeparate(E, E, E, E) !local
glBlendEquation(E) !local
glClear(U) !local
glClearColor(F, F, F, F) !local
glClearStencil(I) !local
glCopyTexSubImage2D(E, I, I, I, I, I, S, S) !local
glDeleteTextures(S, t)
glDisable(E) !local
glDrawArrays(E, I, S) !local
glDrawElements(E, S, E, d) !local
glEnable(E) !local
glFinish()
glFlush()
glGenTextures(S, t)
glGetError() -> E
glGetIntegerv(E, g)
glGetString(E) -> P
glPixelStorei(E, I) !local
glScissor(I, I, S, S) !local
glTexImage2D(E, I, I, S, S, I, E, E, x) !local
glTexParameterf(E, E, F) !local
glTexParameteri(E, E, I) !local
glTexSubImage2D(E, I, I, I, S, S, E, E, y) !local
glViewport(I, I, S, S) !local
glActiveTexture(E) !local
glCompressedTexImage2D(E, I, E, S, S, I, S, z) !local
glVertexAttribPointer(U, I, E, B, S, v) !local
glEnableVertexAttribArray(U) !local
glDisableVertexAttribArray(U) !local
glDeleteProgram(U)
glCreateShader(E) -> U
glShaderSource(U, S, V)
glCompileShader(U)
glCreateProgram() -> U
glAttachShader(U, U)
glLinkProgram(U)
glUseProgram(U) !local
glUniform1f(I, F) !local
glUniform4f(I, F, F, F, F) !local
glUniform1i(I, I) !local
glUniform3fv(I, S, 3) !local
glUniform4fv(I, S, 4) !local
glUniformMatrix3fv(I, S, B, m) !local
glUniformMatrix4fv(I, S, B, M) !local
glGetUniformLocation(U, s) -> I
glBindAttribLocation(U, U, s)
glBindFramebuffer(E, U) !local
glDeleteFramebuffers(S, r)
glGenFramebuffers(S, r)
glFramebufferTexture2D(E, E, E, U, I) !local
glGenerateMipmap(E) !local
glFenceSync(E, U) -> q
glDeleteSync(q)
glClientWaitSync(q, U, U) -> E
