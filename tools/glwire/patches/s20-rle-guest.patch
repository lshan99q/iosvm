+		}
+		began = remote_now_ms();
+		while (in < packed_size) {
+			unsigned code = packed_bytes[in++];
+
+			if ((code & 0x80) != 0) {
+				size_t run = (code & 0x7f) + 3;
+				uint32_t value = 0;
+
+				if (in + pixel_bytes > packed_size) {
+					break;
+				}
+				if (out + run * (size_t)pixel_bytes > raw) {
