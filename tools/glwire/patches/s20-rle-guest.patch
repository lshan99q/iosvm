+
+		if (sscanf(reply, "Z %zu %zu", &raw, &packed_size) != 2) {
+			goto bad_z;
+		}
+		if (raw == (size_t)width * (size_t)height * 2) {
+			pixel_bytes = 2;
+		} else if (raw == (size_t)width * (size_t)height * 4) {
+			pixel_bytes = 4;
+		} else {
+			goto bad_z;
+		}
+		if (packed_size > raw + raw / 64 + 32) {
+			goto bad_z;
+		}
