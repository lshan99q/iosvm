+#include <sys/hakios.virtio_gpu.h>
 
 /* the ends of a run (loader_return.c, the guards), which have no header of their own */
 void hakios_adsp_stop(void);
@@ -53,6 +54,10 @@ void hakios_ufs_quiesce(void) {}
 void hakios_var_save_on_return(void) {}         /* no flash, so no data volume to save into it */
 #endif
 
+#ifndef HAKIOS_VIRTIO_GPU
+void hakios_virtio_gpu_init(void) {}
+#endif
+
 #ifndef HAKIOS_VIRTIO_BLK
 void hakios_virtio_blk_init(void) {}
 bool hakios_virtio_blk_dev(__unused dev_t dev) { return false; }
diff --git a/drivers/gpu/conf b/drivers/gpu/conf
index 931c63a..652bb56 100644
--- a/drivers/gpu/conf
+++ b/drivers/gpu/conf
@@ -2,6 +2,11 @@
 # CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
 # tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.
 
+driver VIRTIO_GPU
+	file    bsd/dev/hakios.virtio_gpu.c
+	help    QEMU's virtio-gpu (device id 16) for the 2D display path (virtio_gpu=1, QEMU only). Stage 23 A1
+	help    discovers it and reads GET_DISPLAY_INFO; no 2D/3D resources yet
+
 driver ADRENO
