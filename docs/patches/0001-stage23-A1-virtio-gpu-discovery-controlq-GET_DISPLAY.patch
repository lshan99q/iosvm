diff --git a/qemu/run-darwin.sh b/qemu/run-darwin.sh
index 0ff94b2..01c883c 100755
--- a/qemu/run-darwin.sh
+++ b/qemu/run-darwin.sh
@@ -18,6 +18,8 @@
 #                          (it hands out an address by DHCP, answers DNS and passes connections on to
 #                          this machine's network; no privileges needed). The kernel makes en0 of it
 #                          (boot-arg virtio_net=1, added here); see userland/src/net_test.m for the rest.
+#      QEMU_VIRTIO_GPU=1   add QEMU's virtio-gpu (stage 23 A1, guest boot-arg virtio_gpu=1).
+#                          Default: no such device, so existing runs are unchanged.
 #      AUDIO=<where>       what plays the sound of Darwin: a QEMU audio back end (pipewire, pa, alsa, sdl: each
 #                          needs its QEMU module, e.g. the package qemu-audio-pipewire) or FILE.wav to
 #                          write it into a file instead. Default: nowhere (the guest plays all the same).
@@ -85,11 +87,28 @@ if qemu-system-aarch64 -device help 2>/dev/null | grep -q '"virtio-sound-device"
 	SOUND+=(-device virtio-sound-device,audiodev=snd,streams=1)   # one stream: output, no microphone of the host
 	CMDLINE="virtio_sound=1 $CMDLINE"
 fi
+# stage 23 A1: optional virtio-gpu, off unless asked for, so old runs keep their device set
+GPU=()
+if [ -n "$QEMU_VIRTIO_GPU" ] && [ "$QEMU_VIRTIO_GPU" != 0 ]; then
+	GPU=(-device virtio-gpu-device)
+	CMDLINE="virtio_gpu=1 $CMDLINE"
+fi
+# VNC=1 gives the machine a VNC console on 127.0.0.1:5909 instead of no display at all, so that a
+# VNC client can watch it -- and, the reason it is the primary display and not an extra one, so that
+# the client's pointer is the console's absolute pointer: a second console next to `-display none`
+# delivered its motion as EV_REL, which this guest's touch driver cannot use.
+if [ -n "${VNC:-}" ]; then
+	export QEMU_DISPLAY="vnc=127.0.0.1:${VNC_PORT:-9}"
+	VNCARG=()
+else
+	VNCARG=()
+fi
+
 xnuloader/mkpayload.py -o qemu/payload.bin kernel=$K ramdisk=$ROOT --rdres "$(printf '%x' "$(stat -c %s "$IMG")")" \
 	--cmdline "loader_return_after=$SECS epoch=$(date +%s) virtio_input=1 $CMDLINE" >/dev/null || exit 1
 QEMU_MEM=${RAM_GB}G exec qemu/run.sh $((SECS + 40)) \
-	-object memory-backend-file,id=ram,size=$RAM_SIZE,mem-path="$PWD/qemu/ram.img",share=off \
+	-object memory-backend-file,id=ram,size=$RAM_SIZE,mem-path="$PWD/qemu/ram.img",share=${QEMU_RAM_SHARE:-on} \
 	-machine memory-backend=ram \
-	-global virtio-mmio.force-legacy=false -device virtio-tablet-device -device virtio-keyboard-device "${NET[@]}" "${SOUND[@]}" \
+	-global virtio-mmio.force-legacy=false -device virtio-tablet-device,id=tablet -device virtio-keyboard-device,id=keys "${VNCARG[@]}" "${NET[@]}" "${SOUND[@]}" "${GPU[@]}" \
 	-device ramfb -monitor tcp:127.0.0.1:$((4444 + 10 * INSTANCE)),server,nowait \
 	-qmp tcp:127.0.0.1:$((4445 + 10 * INSTANCE)),server,nowait "$@"
diff --git a/xnu/files/bsd/sys/hakios.virtio_gpu.h b/xnu/files/bsd/sys/hakios.virtio_gpu.h
new file mode 100644
index 0000000..e35a808
--- /dev/null
