+	domain = ((id (*)(id, SEL))objc_msgSend)(error, sel_registerName("domain"));
+	description = ((id (*)(id, SEL))objc_msgSend)(error, sel_registerName("localizedDescription"));
+	userinfo = ((id (*)(id, SEL))objc_msgSend)(error, sel_registerName("userInfo"));
+	code = (long)((long (*)(id, SEL))objc_msgSend)(error, sel_registerName("code"));
+	say("hakios: sbwp: err: %s %s domain %s code %ld desc %.400s\n",
+	    tag, class_getName(object_getClass(error)), sb_probe_text(domain), code,
+	    sb_probe_text(description));
+	if (userinfo != nil) {
+		say("hakios: sbwp: err: %s userInfo %.600s\n", tag, sb_probe_text(userinfo));
+	}
