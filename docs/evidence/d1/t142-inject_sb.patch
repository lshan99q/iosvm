+/* t142: one object on the poster side. Only the ivars that would name a store, a provider or a
+ * configuration are printed (the rest is the object's own business), then the selectors around
+ * snapshots, then the entry points PaperBoardUI's strings name. */
+static void
+sb_probe_poster_object(const char *label, id object)
+{
+	static const char *const selectors[] = {
+		"snapshotURL", "_snapshotURL", "snapshotDirectory", "snapshotSource",
+		"portalImageProvider", "activeVariantProvider", "processedImage",
+		"wallpaperView", "posterConfiguration", "configuration", "traitCollection",
+	};
+	static const char *const entries[] = {
+		"snapshotIfNeeded", "_scheduleSnapshotIfNeeded",
+	};
+	static const char *const ask[] = {
+		"performSnapshotOnQueue:completion:", "_performSnapshotOnQueue:completion:",
+	};
+	Class cls;
+	Ivar *list;
+	unsigned count = 0, i;
+
+	if (object == nil) {
+		say("hakios: sbwp: poster %s: (nil)\n", label);
+		return;
+	}
+	cls = object_getClass(object);
+	say("hakios: sbwp: poster %s %s\n", label, class_getName(cls));
+	list = class_copyIvarList(cls, &count);
+	for (i = 0; list != NULL && i < count && i < 160; i++) {
+		const char *name = ivar_getName(list[i]);
+		const char *type = ivar_getTypeEncoding(list[i]);
+
+		if (name == NULL) {
+			continue;
+		}
+		if (strstr(name, "snapshot") == NULL && strstr(name, "Snapshot") == NULL &&
+		    strstr(name, "portal") == NULL && strstr(name, "Portal") == NULL &&
+		    strstr(name, "provider") == NULL && strstr(name, "Provider") == NULL &&
+		    strstr(name, "URL") == NULL && strstr(name, "url") == NULL &&
+		    strstr(name, "config") == NULL && strstr(name, "Config") == NULL &&
+		    strstr(name, "variant") == NULL && strstr(name, "Variant") == NULL) {
+			continue;
+		}
+		if (type != NULL && type[0] == '@') {
+			id held = object_getIvar(object, list[i]);
+
+			say("hakios: sbwp: poster %s: %s %s = %s\n", label, name, type,
+			    held != nil ? class_getName(object_getClass(held)) : "nil");
+		} else {
+			say("hakios: sbwp: poster %s: %s %s\n", label, name,
+			    type != NULL ? type : "?");
+		}
+	}
+	free(list);
+	for (i = 0; i < sizeof(selectors) / sizeof(selectors[0]); i++) {
+		SEL sel = sel_registerName(selectors[i]);
+
+		if (!class_respondsToSelector(cls, sel)) {
+			continue;
+		}
+		{
+			id value = ((id (*)(id, SEL))objc_msgSend)(object, sel);
+
+			say("hakios: sbwp: poster %s: -%s %s\n", label, selectors[i],
+			    sb_probe_text(value));
+		}
+	}
+	for (i = 0; i < sizeof(entries) / sizeof(entries[0]); i++) {
+		SEL sel = sel_registerName(entries[i]);
+
+		if (!class_respondsToSelector(cls, sel)) {
+			continue;
+		}
+		say("hakios: sbwp: poster %s: calling -%s\n", label, entries[i]);
+		((void (*)(id, SEL))objc_msgSend)(object, sel);
+		say("hakios: sbwp: poster %s: -%s returned\n", label, entries[i]);
+	}
+	for (i = 0; i < sizeof(ask) / sizeof(ask[0]); i++) {
+		SEL sel = sel_registerName(ask[i]);
+
+		if (!class_respondsToSelector(cls, sel)) {
+			continue;
+		}
+		{
+			/* the block takes no argument on purpose: an extra one the callee passes is
+			 * ignored, while reading one that was never passed would be a bad pointer */
+			void (^completion)(void) = ^{
+				say("hakios: sbwp: poster %s: -%s completion\n", label, ask[i]);
+			};
+			void *raw = *(void **)&completion;
+
+			say("hakios: sbwp: poster %s: calling -%s\n", label, ask[i]);
+			((void (*)(id, SEL, void *, void *))objc_msgSend)(object, sel,
+			    (void *)dispatch_get_main_queue(), raw);
+		}
+	}
+}
