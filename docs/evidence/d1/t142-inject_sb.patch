+static void
+sb_probe_snapshot_classes(void *context)
+{
+	static const char *const classes[] = {
+		"PBUIPosterWallpaperViewController", "PBUIPosterHomeViewController",
+		"PBUIPosterLockViewController", "PBUIPosterVariantViewController",
+		"PBUIPosterPortalImageProvider", "PBUIPosterActiveVariantImageProvider",
+		"PBUIPosterWindowScene", "PBUIPosterWallpaperRemoteViewController",
+	};
+	unsigned i;
+
+	(void)context;
+	for (i = 0; i < sizeof(classes) / sizeof(classes[0]); i++) {
+		sb_dump_class_methods(classes[i], 260);
+	}
+	sb_dump_protocol_methods("PBUIPosterReplicaPortalProviding");
+	sb_dump_protocol_methods("PBUIPosterReplicaSnapshotProviding");
+}
