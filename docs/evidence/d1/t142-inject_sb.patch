+/* t142: the two replica protocols and the four poster view controller classes were absent from
+ * every class dump because those dumps name their classes by hand (t141 :3004-3006, :3059,
+ * :3481-3486). Ask the runtime: class_copyMethodList says whether a class exists at all and what
+ * its whole instance surface is, protocol_copyMethodDescriptionList gives the real signatures. */
+static void
+sb_dump_protocol_methods(const char *name)
+{
+	Protocol *protocol = objc_getProtocol(name);
+	struct objc_method_description *required_list = NULL;
+	struct objc_method_description *optional_list = NULL;
+	unsigned required = 0, optional = 0, i;
+
+	if (protocol == NULL) {
+		say("hakios: sbwp: proto %s: absent\n", name);
+		return;
+	}
+	required_list = protocol_copyMethodDescriptionList(protocol, YES, YES, &required);
+	optional_list = protocol_copyMethodDescriptionList(protocol, NO, YES, &optional);
+	say("hakios: sbwp: proto %s required %u optional %u\n", name, required, optional);
+	for (i = 0; i < required && required_list != NULL; i++) {
+		say("hakios: sbwp: proto %s -%s %s\n", name,
+		    sel_getName(required_list[i].name),
+		    required_list[i].types != NULL ? required_list[i].types : "?");
+	}
+	for (i = 0; i < optional && optional_list != NULL; i++) {
+		say("hakios: sbwp: proto %s opt -%s %s\n", name,
+		    sel_getName(optional_list[i].name),
+		    optional_list[i].types != NULL ? optional_list[i].types : "?");
+	}
+	free(required_list);
+	free(optional_list);
+}
