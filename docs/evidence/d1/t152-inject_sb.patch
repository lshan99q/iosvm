+static id
+sb_setwp_image(void)
+{
+	static const char *const path = "/redwood/var/d1test.png";
+	Class string_class = objc_lookUpClass("NSString");
+	Class url_class = objc_lookUpClass("NSURL");
+	Class image_class = objc_lookUpClass("UIImage");
+	CGImageSourceRef source;
+	CGImageRef cgimage;
+	id ns_path, ns_url, image = nil;
+	size_t width, height;
+
+	if (string_class == Nil || url_class == Nil || image_class == Nil) {
+		say("hakios: sbwp: setwp img skip no UIKit\n");
+		return nil;
+	}
+	ns_path = ((id (*)(Class, SEL, const char *))objc_msgSend)(string_class,
+	    sel_registerName("stringWithUTF8String:"), path);
+	if (ns_path == nil) {
+		say("hakios: sbwp: setwp img no path\n");
+		return nil;
+	}
+	ns_url = ((id (*)(Class, SEL, id))objc_msgSend)(url_class,
+	    sel_registerName("fileURLWithPath:"), ns_path);
+	if (ns_url == nil) {
+		say("hakios: sbwp: setwp img no url %s\n", path);
+		return nil;
+	}
+	source = CGImageSourceCreateWithURL((CFURLRef)ns_url, NULL);
+	if (source == NULL) {
+		say("hakios: sbwp: setwp img no source %s\n", path);
+		return nil;
+	}
+	cgimage = CGImageSourceCreateImageAtIndex(source, 0, NULL);
+	CFRelease(source);
+	if (cgimage == NULL) {
+		say("hakios: sbwp: setwp img no cgimage %s\n", path);
+		return nil;
+	}
+	width = CGImageGetWidth(cgimage);
+	height = CGImageGetHeight(cgimage);
+	if (class_respondsToSelector(object_getClass(image_class),
+	        sel_registerName("imageWithCGImage:scale:orientation:"))) {
+		image = ((id (*)(Class, SEL, CGImageRef, double, long))objc_msgSend)(image_class,
+		    sel_registerName("imageWithCGImage:scale:orientation:"), cgimage, 1.0, 0);
+	}
+	if (image == nil &&
+	    class_respondsToSelector(object_getClass(image_class),
+	        sel_registerName("imageWithCGImage:"))) {
+		image = ((id (*)(Class, SEL, CGImageRef))objc_msgSend)(image_class,
+		    sel_registerName("imageWithCGImage:"), cgimage);
+	}
+	CGImageRelease(cgimage);
+	if (image == nil) {
+		say("hakios: sbwp: setwp img no UIImage %ux%u\n", (unsigned)width, (unsigned)height);
+		return nil;
+	}
+	say("hakios: sbwp: setwp img cls %s %p cg %ux%u\n", class_getName(object_getClass(image)),
+	    image, (unsigned)width, (unsigned)height);
+	return image;
+}
