+/* t155: what PBUIWallpaperOptions says about its size and scale. The t154 size precheck asked
+ * bestWallpaperSizeForWallpaperSize:wallpaperScale:deviceType:imageScale: and got 0x0 back
+ * (cb:8731) while the object came from the manager itself (cb:8730), so list the properties and
+ * the size/scale methods; the answer says which argument the 900 s call is missing. */
+static void
+sb_opt_props(void *context)
+{
+	Class cls = objc_lookUpClass("PBUIWallpaperOptions");
+	unsigned count = 0;
+
+	(void)context;
+	if (cls == Nil) {
+		say("hakios: sbwp: optprop class absent\n");
+		return;
+	}
+	say("hakios: sbwp: optprop class %s\n", class_getName(cls));
+	{
+		objc_property_t *props = class_copyPropertyList(cls, &count);
+
+		say("hakios: sbwp: optprop count %u\n", count);
+		for (unsigned i = 0; props != NULL && i < count; i++) {
+			say("hakios: sbwp: optprop: %s %s\n", property_getName(props[i]),
+			    property_getAttributes(props[i]));
+		}
+		free(props);
+	}
+	{
+		Method *methods = class_copyMethodList(cls, &count);
+
+		say("hakios: sbwp: optmeth count %u\n", count);
+		for (unsigned i = 0; methods != NULL && i < count; i++) {
+			const char *name = sel_getName(method_getName(methods[i]));
+
+			if (strstr(name, "size") == NULL && strstr(name, "Size") == NULL &&
+			    strstr(name, "scale") == NULL && strstr(name, "Scale") == NULL) {
+				continue;
+			}
+			say("hakios: sbwp: optmeth: -%s %s\n", name,
+			    method_getTypeEncoding(methods[i]));
+		}
+		free(methods);
+	}
+}
