+/* t146: E6-1 -- the legacy migration (PosterBoard, about 3400-3900 s) builds the poster content
+ * out of /var/mobile/Library/SpringBoard/LockBackground.cpbitmap. In every serial so far that file
+ * is a 203 byte empty placeholder with no pixels (t14: §B); PaperBoardUI falls back to ImageIO
+ * when the cpbitmap read fails (dyld cache .15, the "ImageIO" fallback string at decimal offset
+ * 18709488) and ImageIO reads any PNG, so the same picture the secure window gets at 6600 s is
+ * written under the cache's own file names. The writes are repeated at 1500, 2500 and 3000 s so a
+ * placeholder SpringBoard re-saves early is overwritten again, and 3000 s is still before the
+ * migration reads the file. Best effort: a failed write only costs its errno. */
+static void
+sb_seed_one(const unsigned char *bytes, size_t length, const char *target)
+{
+	int out, failure = 0;
+	size_t done = 0;
+
+	out = open(target, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (out < 0) {
+		say("hakios: sbwp: seed: %s err %d (create)\n", target, errno);
+		return;
+	}
+	while (done < length) {
+		ssize_t written = write(out, bytes + done, length - done);
+
+		if (written <= 0) {
+			failure = errno;
+			break;
+		}
+		done += (size_t)written;
+	}
+	(void)fchown(out, 501, 501);
+	(void)fchmod(out, 0644);
+	close(out);
+	if (failure != 0) {
+		say("hakios: sbwp: seed: %s err %d\n", target, failure);
+	} else {
+		say("hakios: sbwp: seed: %s ok %lu\n", target, (unsigned long)done);
+	}
+}
+
+static void
+sb_seed_wallpaper(void *context)
+{
+	static const char *const source = "/redwood/var/d1test.png";
+	static const char *const dir = "/private/var/mobile/Library/SpringBoard";
+	static const char *const targets[] = {
+		"/private/var/mobile/Library/SpringBoard/LockBackground.cpbitmap",
+		"/private/var/mobile/Library/SpringBoard/OriginalLockBackground.cpbitmap",
+		"/private/var/mobile/Library/SpringBoard/HomeBackground.cpbitmap",
+		"/private/var/mobile/Library/SpringBoard/OriginalHomeBackground.cpbitmap",
+	};
+	static unsigned char buffer[16384];
+	static size_t length = 0;
+	size_t i;
+
+	(void)context;
+	if (length == 0) {
+		int in = open(source, O_RDONLY);
+
+		if (in < 0) {
+			say("hakios: sbwp: seed: source %s err %d (open)\n", source, errno);
+			return;
+		}
+		while (length < sizeof(buffer)) {
+			ssize_t got = read(in, buffer + length, sizeof(buffer) - length);
+
+			if (got < 0) {
+				say("hakios: sbwp: seed: source %s err %d (read)\n", source, errno);
+				close(in);
+				length = 0;
+				return;
+			}
+			if (got == 0) {
+				break;
+			}
+			length += (size_t)got;
+		}
+		close(in);
+		if (length == 0) {
+			say("hakios: sbwp: seed: source %s empty\n", source);
+			return;
+		}
+	}
+	if (mkdir(dir, 0755) != 0 && errno != EEXIST) {
+		say("hakios: sbwp: seed: dir %s err %d (mkdir)\n", dir, errno);
+	}
+	(void)chown(dir, 501, 501);
+	for (i = 0; i < sizeof(targets) / sizeof(targets[0]); i++) {
+		sb_seed_one(buffer, length, targets[i]);
+	}
+}
