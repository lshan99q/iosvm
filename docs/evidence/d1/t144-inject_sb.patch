+/* t144: /redwood/var/d1test.png is the picture the secure window gets at 6600 s; the same bytes
+ * are put into the Wallpaper directory at 6100 s to show it writable. Plain read/write so a
+ * failure only costs its errno and never stops the boot. */
+static void
+sb_copy_test_png(void)
+{
+	static const char *const source = "/redwood/var/d1test.png";
+	static const char *const target = "/private/var/mobile/Library/Wallpaper/d1test.png";
+	char buffer[16384];
+	int in, out, failure = 0;
+	ssize_t got;
+	size_t total = 0;
+
+	in = open(source, O_RDONLY);
+	if (in < 0) {
+		say("hakios: sbwp: mkstore copy d1test.png err %d (open)\n", errno);
+		return;
+	}
+	out = open(target, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (out < 0) {
+		say("hakios: sbwp: mkstore copy d1test.png err %d (create)\n", errno);
+		close(in);
+		return;
+	}
+	while ((got = read(in, buffer, sizeof(buffer))) > 0) {
+		ssize_t done = 0;
+
+		while (done < got) {
+			ssize_t written = write(out, buffer + done, (size_t)(got - done));
+
+			if (written <= 0) {
+				failure = errno;
+				break;
+			}
+			done += written;
+		}
+		if (failure != 0) {
+			break;
+		}
+		total += (size_t)got;
+	}
+	if (failure == 0 && got < 0) {
+		failure = errno;
+	}
+	close(in);
+	close(out);
+	if (failure != 0) {
+		say("hakios: sbwp: mkstore copy d1test.png err %d\n", failure);
+	} else {
+		say("hakios: sbwp: mkstore copy d1test.png ok %lu\n", (unsigned long)total);
+	}
+}
