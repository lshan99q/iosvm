+/* t144: the scene snapshot is the one route that does not go through the store, so its result
+ * is not left in the serial as a class name: 64x128 PNG, base64, in chunks a serial line can
+ * hold, so the picture can be rebuilt offline. */
+static void
+sb_scene_png(id image)
+{
+	Class renderer_class = objc_lookUpClass("UIGraphicsImageRenderer");
+	Class string_class = objc_lookUpClass("NSString");
+	id small = image;
+	id data = nil, text = nil;
+	const char *bytes = NULL;
+	size_t length, chunks, i;
+	CGSize size;
+
+	if (image == nil) {
+		say("hakios: sbwp: scene png none\n");
+		return;
+	}
+	size = ((CGSize (*)(id, SEL))objc_msgSend)(image, sel_registerName("size"));
+	if (renderer_class != Nil) {
+		id renderer = ((id (*)(id, SEL))objc_msgSend)((id)renderer_class,
+		    sel_registerName("alloc"));
+
+		renderer = ((id (*)(id, SEL, CGSize))objc_msgSend)(renderer,
+		    sel_registerName("initWithSize:"), CGSizeMake(64.0, 128.0));
+		if (renderer != nil) {
+			void (^actions)(id) = ^(id context) {
+				(void)context;
+				((void (*)(id, SEL, CGRect))objc_msgSend)(image,
+				    sel_registerName("drawInRect:"), CGRectMake(0.0, 0.0, 64.0, 128.0));
+			};
+			void *raw = *(void **)&actions;
+			id resized = ((id (*)(id, SEL, void *))objc_msgSend)(renderer,
+			    sel_registerName("imageWithActions:"), raw);
+
+			if (resized != nil) {
+				small = resized;
+			}
+		}
+	}
+	data = UIImagePNGRepresentation(small);
+	if (data == nil) {
+		say("hakios: sbwp: scene png encode failed\n");
+		return;
+	}
+	text = ((id (*)(id, SEL, unsigned long))objc_msgSend)(data,
+	    sel_registerName("base64EncodedStringWithOptions:"), 0UL);
+	bytes = text != nil ? ((const char *(*)(id, SEL))objc_msgSend)(text,
+	    sel_registerName("UTF8String")) : NULL;
+	if (bytes == NULL) {
+		say("hakios: sbwp: scene png base64 failed\n");
+		return;
+	}
+	length = strlen(bytes);
+	chunks = (length + 399) / 400;
+	say("hakios: sbwp: scene png image %.0fx%.0f small %.0fx%.0f png %lu b64 %lu chunks %lu\n",
+	    size.width, size.height,
+	    ((CGSize (*)(id, SEL))objc_msgSend)(small, sel_registerName("size")).width,
+	    ((CGSize (*)(id, SEL))objc_msgSend)(small, sel_registerName("size")).height,
+	    (unsigned long)length, (unsigned long)chunks);
+	for (i = 0; i < chunks; i++) {
+		size_t offset = i * 400;
+		size_t take = length - offset;
+
+		if (take > 400) {
+			take = 400;
+		}
+		say("hakios: sbwp: scene png %lu/%lu %.*s\n", (unsigned long)(i + 1),
+		    (unsigned long)chunks, (int)take, bytes + offset);
+	}
+	(void)string_class;
+}
