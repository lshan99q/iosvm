+/* t144: a completion argument is only a pointer until its isa is known to be a class. Reading
+ * the word at that address is safe (it is a read of our own address space); comparing it with
+ * the runtime's class list says whether the word is an object at all. */
+static bool
+sb_is_object(void *pointer)
+{
+	vm_address_t address = (vm_address_t)pointer;
+	vm_address_t isa = 0;
+	vm_size_t got = 0;
+	Class *classes = NULL;
+	unsigned count = 0, i;
+
+	if (pointer == NULL) {
+		return false;
+	}
+	if (vm_read_overwrite(mach_task_self(), address, sizeof(isa), (vm_address_t)&isa,
+	    &got) != KERN_SUCCESS || got != sizeof(isa) || isa == 0) {
+		return false;
+	}
+	classes = objc_copyClassList(&count);
+	for (i = 0; classes != NULL && i < count; i++) {
+		if ((vm_address_t)classes[i] == isa) {
+			free(classes);
+			return true;
+		}
+	}
+	free(classes);
+	return false;
+}
