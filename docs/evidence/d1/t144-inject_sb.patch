+/* t144: the secure window's root view gets a picture with an obvious gradient and colour blocks.
+ * A frame captured after 6600 s that is still black then means the window has content that never
+ * reaches the screen; visible blocks mean the black is an empty view and the poster path is what
+ * to fix. */
+static void
+sb_inject_wallpaper(void *context)
+{
+	Class controller_class = objc_lookUpClass("SBWallpaperController");
+	Class image_class = objc_lookUpClass("UIImage");
+	Class view_class = objc_lookUpClass("UIImageView");
+	Class string_class = objc_lookUpClass("NSString");
+	id controller = nil, window = nil, root = nil, image = nil, view;
+	CGRect bounds;
+
+	(void)context;
+	if (controller_class != Nil &&
+	    class_respondsToSelector(object_getClass(controller_class),
+	        sel_registerName("sharedInstance"))) {
+		controller = ((id (*)(Class, SEL))objc_msgSend)(controller_class,
+		    sel_registerName("sharedInstance"));
+	}
+	if (controller != nil &&
+	    class_respondsToSelector(object_getClass(controller), sel_registerName("_wallpaperWindow"))) {
+		window = ((id (*)(id, SEL))objc_msgSend)(controller, sel_registerName("_wallpaperWindow"));
+	}
+	if (window == nil) {
+		Class app_class = objc_lookUpClass("UIApplication");
+
+		if (app_class != Nil &&
+		    class_respondsToSelector(object_getClass(app_class),
+		        sel_registerName("sharedApplication"))) {
+			id app = ((id (*)(Class, SEL))objc_msgSend)(app_class,
+			    sel_registerName("sharedApplication"));
+			id windows = app != nil ? ((id (*)(id, SEL))objc_msgSend)(app,
+			    sel_registerName("windows")) : nil;
+			unsigned long count = windows != nil ? ((unsigned long (*)(id, SEL))objc_msgSend)(
+			    windows, sel_registerName("count")) : 0;
+			unsigned long i;
+
+			for (i = 0; i < count; i++) {
+				id candidate = ((id (*)(id, SEL, unsigned long))objc_msgSend)(windows,
+				    sel_registerName("objectAtIndex:"), i);
+				const char *name = candidate != nil ?
+				    class_getName(object_getClass(candidate)) : "";
+
+				if (strstr(name, "WallpaperSecureWindow") != NULL) {
+					window = candidate;
+					break;
+				}
+			}
+		}
+	}
+	if (window == nil) {
+		say("hakios: sbwp: inject: no wallpaper window\n");
+		return;
+	}
+	if (class_respondsToSelector(object_getClass(window), sel_registerName("rootViewController"))) {
+		id controller_view = ((id (*)(id, SEL))objc_msgSend)(window,
+		    sel_registerName("rootViewController"));
+
+		if (controller_view != nil &&
+		    class_respondsToSelector(object_getClass(controller_view), sel_registerName("view"))) {
+			root = ((id (*)(id, SEL))objc_msgSend)(controller_view, sel_registerName("view"));
+		}
+	}
+	if (root == nil) {
+		root = window;
+	}
+	if (image_class != Nil && string_class != Nil) {
+		id path = ((id (*)(id, SEL, const char *))objc_msgSend)((id)string_class,
+		    sel_registerName("stringWithUTF8String:"), "/redwood/var/d1test.png");
+
+		if (path != nil && class_respondsToSelector(object_getClass((id)image_class),
+		        sel_registerName("imageWithContentsOfFile:"))) {
+			image = ((id (*)(Class, SEL, id))objc_msgSend)(image_class,
+			    sel_registerName("imageWithContentsOfFile:"), path);
+		}
+	}
+	if (image == nil) {
+		say("hakios: sbwp: inject: no image /redwood/var/d1test.png\n");
+		return;
+	}
+	if (view_class == Nil) {
+		say("hakios: sbwp: inject: UIImageView absent\n");
+		return;
+	}
+	view = ((id (*)(id, SEL))objc_msgSend)((id)view_class, sel_registerName("alloc"));
+	view = ((id (*)(id, SEL, id))objc_msgSend)(view, sel_registerName("initWithImage:"), image);
+	bounds = ((CGRect (*)(id, SEL))objc_msgSend)(root, sel_registerName("bounds"));
+	((void (*)(id, SEL, CGRect))objc_msgSend)(view, sel_registerName("setFrame:"), bounds);
+	((void (*)(id, SEL, id))objc_msgSend)(root, sel_registerName("addSubview:"), view);
+	say("hakios: sbwp: inject: added %.0fx%.0f root %s window %s\n",
+	    bounds.size.width, bounds.size.height, class_getName(object_getClass(root)),
+	    class_getName(object_getClass(window)));
+}
