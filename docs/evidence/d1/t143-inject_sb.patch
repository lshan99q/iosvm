+/* t143: the offline examination of the t142 image (t14, d1d2bp-offline-store.md:§E4-1) found the
+ * store directories missing -- /var/mobile/Library/PosterBoard, PosterBoard/Extensions and
+ * Wallpaper were neither in the data volume's template (var.skel has no line for them) nor made
+ * at run time, so a snapshot had nowhere to go. The template now makes them (var.skel:122-124);
+ * this makes the same three when /private/var comes from somewhere else, before the poster
+ * service is asked for a configuration (6300 s) and before the refresh burst, and does nothing
+ * when they are already there. createDirectoryAtPath:withIntermediateDirectories: is idempotent
+ * and the attributes are the ones the template uses, 0755 and 501:501. */
+static void
+sb_mkstore(void *context)
+{
+	static const char *const paths[] = {
+		"/private/var/mobile/Library/PosterBoard",
+		"/private/var/mobile/Library/PosterBoard/Extensions",
+		"/private/var/mobile/Library/Wallpaper",
+	};
+	static const char *const key_names[] = { "NSFilePosixPermissions", "NSFileOwnerAccountID",
+		"NSFileGroupOwnerAccountID" };
+	Class manager_class = objc_lookUpClass("NSFileManager");
+	Class string_class = objc_lookUpClass("NSString");
+	Class dict_class = objc_lookUpClass("NSDictionary");
+	Class number_class = objc_lookUpClass("NSNumber");
+	SEL create = sel_registerName("createDirectoryAtPath:withIntermediateDirectories:attributes:error:");
+	id manager, attrs, keys[3], values[3];
+	size_t i;
+
+	(void)context;
+	if (manager_class == Nil || string_class == Nil || dict_class == Nil || number_class == Nil) {
+		say("hakios: sbwp: mkstore no NSFileManager\n");
+		return;
+	}
+	manager = ((id (*)(id, SEL))objc_msgSend)((id)manager_class, sel_registerName("defaultManager"));
+	values[0] = ((id (*)(id, SEL, unsigned int))objc_msgSend)((id)number_class,
+	    sel_registerName("numberWithUnsignedInt:"), 0755);
+	values[1] = ((id (*)(id, SEL, int))objc_msgSend)((id)number_class,
+	    sel_registerName("numberWithInt:"), 501);
+	values[2] = values[1];
+	for (i = 0; i < 3; i++) {
+		keys[i] = ((id (*)(id, SEL, const char *))objc_msgSend)((id)string_class,
+		    sel_registerName("stringWithUTF8String:"), key_names[i]);
+	}
+	attrs = ((id (*)(id, SEL, id *, id *, unsigned long))objc_msgSend)((id)dict_class,
+	    sel_registerName("dictionaryWithObjects:forKeys:count:"), values, keys, 3);
+	for (i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		id path = ((id (*)(id, SEL, const char *))objc_msgSend)((id)string_class,
+		    sel_registerName("stringWithUTF8String:"), paths[i]);
+		BOOL ok = NO;
+		int saved = 0;
+
+		if (path != nil && attrs != nil) {
+			ok = ((BOOL (*)(id, SEL, id, BOOL, id, id *))objc_msgSend)(manager, create, path, YES,
+			    attrs, NULL);
+			saved = errno;
+		}
+		say("hakios: sbwp: mkstore %s %s %d\n", paths[i], ok ? "ok" : "err", ok ? 0 : saved);
+	}
+}
