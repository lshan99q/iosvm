+/* t147: 6440 s lock / 6490 s home, just before the burst asks them at 6450/6500. */
+static void
+sb_probe_config_dirs(void *context)
+{
+	int use_home = (int)(intptr_t)context;
+	Class controller_class = objc_lookUpClass("SBWallpaperController");
+	id controller, config = nil;
+	Ivar config_ivar;
+
+	if (controller_class == Nil ||
+	    !class_respondsToSelector(object_getClass(controller_class), sel_registerName("sharedInstance"))) {
+		return;
+	}
+	controller = ((id (*)(Class, SEL))objc_msgSend)(controller_class,
+	    sel_registerName("sharedInstance"));
+	if (controller == nil) {
+		return;
+	}
+	config_ivar = class_getInstanceVariable(controller_class,
+	    use_home ? "_activeHomeScreenPosterConfiguration" : "_activeLockScreenPosterConfiguration");
+	config = config_ivar != NULL ? object_getIvar(controller, config_ivar) : nil;
+	sb_config_probe(config, use_home ? "home" : "lock", 1);
+}
