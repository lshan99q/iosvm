+/* t147: E4 (wp4-d1-be, serial 544439/509014) answered refresh with NSCocoaErrorDomain -1 and an
+ * empty userInfo although the three store directories existed (mkstore ok), so the write that
+ * fails is under the configuration's own assetDirectory, not under Library/PosterBoard. Ask the
+ * configuration for its paths (respondsToSelector first, then KVC; this file is built without
+ * exceptions, so no @try), create the directory and list what is in it before the ask, and again
+ * after a failed one. */
+static id
+sb_config_value(id config, const char *key)
+{
+	Class cls, string_class;
+	SEL sel, kvc;
+	id name;
+
+	if (config == nil) {
+		return nil;
+	}
+	cls = object_getClass(config);
+	sel = sel_registerName(key);
+	if (class_respondsToSelector(cls, sel)) {
+		return ((id (*)(id, SEL))objc_msgSend)(config, sel);
+	}
+	/* try the underscore spelling before KVC (the configuration keeps most of its state in
+	 * _-prefixed ivars); a key the class does not answer at all is skipped: -valueForKey: on an
+	 * unknown key raises NSUnknownKeyException, and this file is built as C without exceptions
+	 * (an @try here would abort the probe at 6440 s instead of printing nil). */
+	{
+		char alt[96];
+
+		snprintf(alt, sizeof(alt), "_%s", key);
+		sel = sel_registerName(alt);
+		if (class_respondsToSelector(cls, sel)) {
+			return ((id (*)(id, SEL))objc_msgSend)(config, sel);
+		}
+	}
+	kvc = sel_registerName("valueForKey:");
+	if (class_respondsToSelector(cls, kvc)) {
+		string_class = objc_lookUpClass("NSString");
+		if (string_class != Nil) {
+			name = ((id (*)(Class, SEL, const char *))objc_msgSend)(string_class,
+			    sel_registerName("stringWithUTF8String:"), key);
+			if (name != nil) {
+				/* KVC is safe only for a key the class resolves to a property/ivar; ask
+				 * for the property list check first (NSObject answers this on all
+				 * configurations, so an unknown key never reaches -valueForKey:). */
+				SEL glv = sel_registerName("valueForUndefinedKey:");
+				BOOL undefined = class_respondsToSelector(cls, glv);
+
+				if (!undefined) {
+					return ((id (*)(id, SEL, id))objc_msgSend)(config, kvc, name);
+				}
+			}
+		}
+	}
+	return nil;
+}
+
+/* an assetDirectory is a path string in the dumps, but a URL answers -path; keep both working */
+static id
+sb_config_path(id value)
+{
+	if (value != nil && strcmp(class_getName(object_getClass(value)), "NSString") != 0 &&
+	    class_respondsToSelector(object_getClass(value), sel_registerName("path"))) {
+		id path = ((id (*)(id, SEL))objc_msgSend)(value, sel_registerName("path"));
+
+		if (path != nil) {
+			return path;
+		}
+	}
+	return value;
+}
+
+static void
+sb_config_probe(id config, const char *tag, int make)
+{
+	Class manager_class = objc_lookUpClass("NSFileManager");
+	Class string_class = objc_lookUpClass("NSString");
+	Class dict_class = objc_lookUpClass("NSDictionary");
+	id asset, desc, uuid, provider, role, url, manager = nil;
+
+	if (config == nil) {
+		say("hakios: sbwp: cfg %s nil config\n", tag);
+		return;
+	}
+	desc = sb_config_value(config, "description");
+	uuid = sb_config_value(config, "posterUUID");
+	provider = sb_config_value(config, "provider");
+	role = sb_config_value(config, "role");
+	url = sb_config_value(config, "snapshotURL");
+	asset = sb_config_path(sb_config_value(config, "assetDirectory"));
+	say("hakios: sbwp: cfg %s desc %.300s\n", tag, sb_probe_text(desc));
+	say("hakios: sbwp: cfg %s uuid %.200s provider %.200s role %.200s url %.300s\n", tag,
+	    sb_probe_text(uuid), sb_probe_text(provider), sb_probe_text(role), sb_probe_text(url));
+	say("hakios: sbwp: cfg %s asset %.400s\n", tag, sb_probe_text(asset));
+	if (asset == nil || manager_class == Nil || string_class == Nil) {
+		return;
+	}
+	manager = ((id (*)(Class, SEL))objc_msgSend)(manager_class,
+	    sel_registerName("defaultManager"));
+	if (manager == nil) {
+		return;
+	}
+	if (make && dict_class != Nil) {
+		id key = ((id (*)(Class, SEL, const char *))objc_msgSend)(string_class,
+		    sel_registerName("stringWithUTF8String:"), "NSFilePosixPermissions");
+		id perm = ((id (*)(Class, SEL, int))objc_msgSend)(objc_lookUpClass("NSNumber"),
+		    sel_registerName("numberWithInt:"), 0755);
+		id attrs = key != nil && perm != nil ?
+		    ((id (*)(Class, SEL, id, id, ...))objc_msgSend)(dict_class,
+		        sel_registerName("dictionaryWithObjectsAndKeys:"), perm, key, nil) : nil;
+		BOOL ok = ((BOOL (*)(id, SEL, id, BOOL, id, void *))objc_msgSend)(manager,
+		    sel_registerName("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),
+		    asset, YES, attrs, NULL);
+		int err = ok ? 0 : errno;
+
+		say("hakios: sbwp: cfg %s mkdir %s errno %d\n", tag, ok ? "ok" : "err", err);
+	}
+	{
+		unsigned long count = 0, i;
+		id names = ((id (*)(id, SEL, id, void *))objc_msgSend)(manager,
+		    sel_registerName("contentsOfDirectoryAtPath:error:"), asset, NULL);
+
+		if (names != nil) {
+			count = ((unsigned long (*)(id, SEL))objc_msgSend)(names,
+			    sel_registerName("count"));
+		}
+		say("hakios: sbwp: cfg %s list count %lu\n", tag, count);
+		for (i = 0; i < count && i < 64; i++) {
+			id name = ((id (*)(id, SEL, unsigned long))objc_msgSend)(names,
+			    sel_registerName("objectAtIndex:"), i);
+			id sub = ((id (*)(id, SEL, id))objc_msgSend)(asset,
+			    sel_registerName("stringByAppendingPathComponent:"), name);
+			id info = ((id (*)(id, SEL, id, void *))objc_msgSend)(manager,
+			    sel_registerName("attributesOfItemAtPath:error:"), sub, NULL);
+			id skey = ((id (*)(Class, SEL, const char *))objc_msgSend)(string_class,
+			    sel_registerName("stringWithUTF8String:"), "NSFileSize");
+			id size = info != nil && skey != nil ? ((id (*)(id, SEL, id))objc_msgSend)(info,
+			    sel_registerName("objectForKey:"), skey) : nil;
+			unsigned long long bytes = size != nil ?
+			    ((unsigned long long (*)(id, SEL))objc_msgSend)(size,
+			        sel_registerName("unsignedLongLongValue")) : 0;
+
+			say("hakios: sbwp: cfg %s list %s %llu\n", tag, sb_probe_text(name), bytes);
+		}
+	}
+}
