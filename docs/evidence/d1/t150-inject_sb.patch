+static void
+sb_config_stat(const char *tag, id asset)
+{
+	const char *path;
+	struct stat st;
+	char names[16][256];
+	unsigned count = 0, i;
+	DIR *dir;
+
+	if (asset == nil) {
+		say("hakios: sbwp: cfg %s stat nil\n", tag);
+		return;
+	}
+	path = ((const char *(*)(id, SEL))objc_msgSend)(asset, sel_registerName("UTF8String"));
+	if (path == NULL) {
+		say("hakios: sbwp: cfg %s stat path nil\n", tag);
+		return;
+	}
+	if (access(path, F_OK) != 0) {
+		say("hakios: sbwp: cfg %s stat %s absent errno %d (%s)\n", tag, path, errno,
+		    strerror(errno));
+		return;
+	}
+	if (lstat(path, &st) != 0) {
+		say("hakios: sbwp: cfg %s stat %s lstat errno %d (%s)\n", tag, path, errno,
+		    strerror(errno));
+		return;
+	}
+	say("hakios: sbwp: cfg %s stat %s mode %o uid %u gid %u size %lld\n", tag, path,
+	    (unsigned)st.st_mode, (unsigned)st.st_uid, (unsigned)st.st_gid, (long long)st.st_size);
+	dir = opendir(path);
+	if (dir == NULL) {
+		say("hakios: sbwp: cfg %s open %s errno %d (%s)\n", tag, path, errno, strerror(errno));
+		return;
+	}
+	while (count < 16) {
+		struct dirent *entry = readdir(dir);
+
+		if (entry == NULL) {
+			break;
+		}
+		if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
+			continue;
+		}
+		snprintf(names[count], sizeof(names[count]), "%s", entry->d_name);
+		count++;
+	}
+	closedir(dir);
+	say("hakios: sbwp: cfg %s list count %u\n", tag, count);
+	for (i = 0; i < count; i++) {
+		say("hakios: sbwp: cfg %s list %s\n", tag, names[i]);
+	}
+}
