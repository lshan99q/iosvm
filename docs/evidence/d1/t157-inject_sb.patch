+/* t157: cb serial 508961/508962 showed the scene snapshot does hand back an IOSurface
+ * ("texture 187: IOSurface 34 4997120 byte(s) ... row 3072", then "scene: snapshot image
+ * IOSurface"), but the t147 completion declared the argument an NSError and +[_FBSSnapshot
+ * domain] ended SpringBoard (508964/508968/515819). The object is kept here: its pixels are
+ * sampled (is the wallpaper black?), and at 6600 s the surface is painted straight onto the
+ * secure window's root view layer, so a still-black frame separates "no pixels" from "pixels
+ * that never reach the screen". */
+static IOSurfaceRef sb_scene_surface;
+
+static int
+sb_scene_is_surface(id object)
+{
+	if (object == nil || !sb_is_object(object)) {
+		return 0;
+	}
+	return CFGetTypeID((CFTypeRef)object) == IOSurfaceGetTypeID();
+}
+
+static void
+sb_scene_surface_stats(IOSurfaceRef surface)
+{
+	size_t width = IOSurfaceGetWidth(surface), height = IOSurfaceGetHeight(surface);
+	size_t bpr = IOSurfaceGetBytesPerRow(surface);
+	unsigned char *base;
+	unsigned long long sum = 0, dark = 0, count = 0, i, j;
+	unsigned min = 255, max = 0;
+
+	if (IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL) != 0) {
+		say("hakios: sbwp: scene: ios lock failed\n");
+		return;
+	}
+	base = IOSurfaceGetBaseAddress(surface);
+	if (base == NULL) {
+		IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+		say("hakios: sbwp: scene: ios no base %zux%zu bpr %zu\n", width, height, bpr);
+		return;
+	}
+	for (j = 0; j < height; j += 16) {
+		unsigned char *row = base + j * bpr;
+
+		for (i = 0; i < width; i += 16) {
+			unsigned r = row[i * 4], g = row[i * 4 + 1], b = row[i * 4 + 2];
+			unsigned l = (r + g + b) / 3;
+
+			sum += l;
+			count++;
+			if (l < 16) {
+				dark++;
+			}
+			if (l < min) {
+				min = l;
+			}
+			if (l > max) {
+				max = l;
+			}
+		}
+	}
+	IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+	say("hakios: sbwp: scene: ios %zux%zu bpr %zu mean %llu dark %llu.%llu%% min %u max %u samples %llu\n",
+	    width, height, bpr,
+	    count > 0 ? sum / count : 0,
+	    count > 0 ? dark * 100 / count : 0,
+	    count > 0 ? (dark * 1000 / count) % 10 : 0,
+	    min, max, count);
+}
+
+static void
+sb_scene_surface_png(IOSurfaceRef surface)
+{
+	Class ci_image_class = objc_lookUpClass("CIImage");
+	Class ci_context_class = objc_lookUpClass("CIContext");
+	Class ui_image_class = objc_lookUpClass("UIImage");
+	id ci = nil, context = nil, ui = nil;
+	CGImageRef cg = NULL, small = NULL;
+	CGColorSpaceRef space;
+	CGContextRef context_ref;
+	unsigned char *buffer;
+	CGRect extent;
+
+	if (ci_image_class == Nil || ci_context_class == Nil || ui_image_class == Nil) {
+		say("hakios: sbwp: scene: png no CoreImage/UIKit\n");
+		return;
+	}
+	if (class_respondsToSelector(object_getClass(ci_image_class),
+	        sel_registerName("imageWithIOSurface:"))) {
+		ci = ((id (*)(Class, SEL, IOSurfaceRef))objc_msgSend)(ci_image_class,
+		    sel_registerName("imageWithIOSurface:"), surface);
+	}
+	if (ci == nil) {
+		say("hakios: sbwp: scene: png no CIImage\n");
+		return;
+	}
+	context = ((id (*)(Class, SEL))objc_msgSend)(ci_context_class, sel_registerName("context"));
+	if (context == nil) {
+		say("hakios: sbwp: scene: png no CIContext\n");
+		return;
+	}
+	extent = ((CGRect (*)(id, SEL))objc_msgSend)(ci, sel_registerName("extent"));
+	cg = ((CGImageRef (*)(id, SEL, id, CGRect))objc_msgSend)(context,
+	    sel_registerName("createCGImage:fromRect:"), ci, extent);
+	if (cg == NULL) {
+		say("hakios: sbwp: scene: png no CGImage\n");
+		return;
+	}
+	buffer = calloc(64 * 128 * 4, 1);
+	space = CGColorSpaceCreateDeviceRGB();
+	context_ref = buffer != NULL ? CGBitmapContextCreate(buffer, 64, 128, 8, 64 * 4, space,
+	    kCGImageAlphaPremultipliedLast) : NULL;
+	if (context_ref != NULL) {
+		CGContextDrawImage(context_ref, CGRectMake(0.0, 0.0, 64.0, 128.0), cg);
+		small = CGBitmapContextCreateImage(context_ref);
+	}
+	if (small != NULL) {
+		ui = ((id (*)(id, SEL, CGImageRef))objc_msgSend)((id)ui_image_class,
+		    sel_registerName("imageWithCGImage:"), small);
+	}
+	if (ui != nil) {
+		say("hakios: sbwp: scene: png from ios %zux%zu\n", IOSurfaceGetWidth(surface),
+		    IOSurfaceGetHeight(surface));
+		sb_scene_png(ui);
+	} else {
+		say("hakios: sbwp: scene: png thumb failed\n");
+	}
+	if (small != NULL) {
+		CGImageRelease(small);
+	}
+	if (context_ref != NULL) {
+		CGContextRelease(context_ref);
+	}
+	if (space != NULL) {
+		CGColorSpaceRelease(space);
+	}
+	CGImageRelease(cg);
+	free(buffer);
+}
