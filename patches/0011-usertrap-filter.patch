 static TUNABLE(uint32_t, user_exception_trace_enabled, "systrace", 0);
+/*
+ * A quieter way to ask for the same lines: boot-arg ustrace=1 turns on the exception trace alone
+ * (systrace=1 also turns on the syscall trace, which is thousands of lines a second), and
+ * ustrace_name=NAME keeps it to one process -- ustrace=1 ustrace_name=backboardd is the pair that
+ * shows where the window server died without drowning the console.
+ */
+static TUNABLE(uint32_t, user_exception_trace_only, "ustrace", 0);
+static TUNABLE_STR(user_exception_trace_name, 32, "ustrace_name", "");
 
