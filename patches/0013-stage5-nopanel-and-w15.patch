+int eagl_remote_panel_upload_on(void);
 int eagl_remote_surface(GLsizei width, GLsizei height, void *base, GLsizei row_bytes);
 
 #define SLOTS           0x440           /* entries of the table: more than Darwin's has (checked below) */
@@ -786,6 +787,53 @@
 	e->upload_bytes += row * (size_t)image->height;
 }
 
+/*
+ * W1.5, the other half of "the host draws the frame": with nothing drawn here the surfaces of the
+ * layers are never reached by surface_to_texture() -- its callers are the binding and drawing paths,
+ * and those are what remote_only leaves out -- so the host would be handed a stream that samples
+ * textures it has never been given (the black screen of the fourth stage's R3).  This sends the same
+ * pixels by reference instead: the record names the IOSurface's pages, the host fills its texture
+ * from them, and Mesa's texstore (the cost W1 is about) does not happen here at all.
+ *
+ * Only what has changed is sent, by the two signs surface_to_texture() uses: the surface's seed, and
+ * a sum of its memory for a surface that is being drawn into without the seed moving.  The pictures
+ * that have to be turned over (invert, alpha first) cannot travel by reference, so those are filled
+ * here as before -- correctness first, and they are the display's own surfaces, one a frame.
+ */
+static void
+upload_changed_layers(struct eagl *e)
+{
+	for (unsigned i = 0; i < e->image_count; i++) {
+		struct image *image = &e->images[i];
+		IOSurfaceRef surface = image->surface;
+		size_t row, pixel = bytes_a_pixel(image->format, image->type);
+		uint8_t *base;
+
+		if (surface == NULL || image->target || image->shared || image->width <= 0 ||
+		    image->height <= 0 || IOSurfaceGetPlaneCount(surface) > 0) {
+			continue;
+		}
+		if (IOSurfaceGetSeed(surface) == image->seed && !surface_changed(e, image)) {
+			continue;
+		}
+		if (image->invert || image->alpha_first) {
+			surface_to_texture(e, image);   /* (turned over on the way: by copy, as it always was) */
+			continue;
+		}
+		base = IOSurfaceGetBaseAddress(surface);
+		if (base == NULL) {
+			continue;
+		}
+		row = IOSurfaceGetBytesPerRow(surface);
+		eagl_remote_upload(image->texture, image->to,
+		    (GLint)internal_format(image->internal, image->format), image->width, image->height,
+		    image->format, image->type, base, (GLsizei)row, (GLsizei)pixel);
+		image->seed = IOSurfaceGetSeed(surface);
+		e->uploads++;
+		e->upload_bytes += row * (size_t)image->height;
+	}
+}
