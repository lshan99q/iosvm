+/* (glslots=1) One line: the entries the wire does not carry and how many calls each has had.
+ * Printed at frame 30 and every two hundredth frame from there (frame_end()) -- a boot that ends
+ * before frame 200 still says what has been called. */
+static void
+watched_slots_report(struct eagl *e)
+{
+	char line[512];
+	int at = snprintf(line, sizeof(line), "hakios-gl: slots after %u frames:", e->frames);
+	unsigned listed = 0;
+
+	for (unsigned i = 0; i < sizeof(watched_slots) / sizeof(watched_slots[0]); i++) {
+		unsigned calls = slot_calls[watched_slots[i].offset / 8];
+
+		if (calls == 0) {
+			continue;
+		}
+		if (at < (int)sizeof(line)) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, "%s%s %u", listed == 0 ? " " : ", ",
+			    watched_slots[i].name, calls);
+		}
+		listed++;
+	}
+	if (listed == 0) {
+		say("hakios-gl: slots after %u frames: none of the %zu entries the wire does not carry was called\n", e->frames,
+		    sizeof(watched_slots) / sizeof(watched_slots[0]));
+	} else {
+		say("%s\n", line);
+	}
+}
