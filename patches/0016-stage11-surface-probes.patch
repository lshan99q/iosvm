+static void
+surface_say(struct eagl *e, const char *when, unsigned frame)
+{
+	struct image *image = e->image_count > 0 ? &e->images[0] : NULL;
+	const unsigned char *base;
+	size_t row, used;
+	int rows[5];
+	uint32_t hash[5];
+	uint32_t px[2] = { 0, 0 };
+
+	if (image == NULL || image->surface == NULL || image->width <= 0 || image->height <= 0) {
+		return;
+	}
+	base = IOSurfaceGetBaseAddress(image->surface);
+	row = IOSurfaceGetBytesPerRow(image->surface);
+	used = (size_t)image->width * 4;
+	if (base == NULL || row < used) {
+		return;
+	}
+	rows[0] = 0;
+	rows[1] = image->height / 4;
+	rows[2] = image->height / 2;
+	rows[3] = (3 * image->height) / 4;
+	rows[4] = image->height - 1;
+	for (int i = 0; i < 5; i++) {
+		hash[i] = surface_row_hash(base + row * (size_t)rows[i], used);
+	}
+	memcpy(px, base + row * (size_t)rows[2], sizeof(px));
+	memcpy(px + 1, base + row * (size_t)rows[2] + used - 4, sizeof(px[1]));
+	say("hakios-remote: s11 %s f %u surface %u %dx%d row %zu rows %08x %08x %08x %08x %08x "
+	    "px %08x %08x\n", when, frame, (unsigned)IOSurfaceGetID(image->surface), image->width,
+	    image->height, row, hash[0], hash[1], hash[2], hash[3], hash[4], px[0], px[1]);
+}
