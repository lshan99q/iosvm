+/*
+ * Stage 11, P1'''': the display surface's own fingerprint. Five rows, five pixels a row, hashed
+ * exactly as host_glwire hashes the picture it drew (tools/glwire/host_glwire.c, sample_row_hash),
+ * so the guest's log and the host's can be compared number for number: a surface that holds the
+ * host's picture has the same five hashes on both sides, and one that still holds what was there
+ * before does not. "left" is taken before this frame clears the surface (what the last frame left
+ * in it, which says whether somebody cleared it after the host wrote); "after" once the host's rows
+ * have been written into it (in place) or the picture has been copied into it (by hand).
+ */
+static uint32_t
+surface_row_hash(const unsigned char *row, size_t used)
+{
+	uint32_t hash = 2166136261u;
+
+	if (row == NULL || used < 4) {
+		return hash;
+	}
+	for (int i = 0; i < 5; i++) {
+		size_t pixel = ((used / 4) - 1) * (size_t)i / 4 * 4;
+
+		for (int b = 0; b < 4; b++) {
+			hash = (hash ^ row[pixel + (size_t)b]) * 16777619u;
+		}
+	}
+	return hash;
+}
