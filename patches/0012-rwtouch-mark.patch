# 0012: rwtouch's mark, and the driven job list
#
# The touch driver is how a boot gets frames out of an idle home screen, and how R5's
# 'twenty seconds of a scrolling settings list' is timed.  Two things had to be added:
#
#  - rwtouch mark TEXT: a line of our own on the console, so a measurement window has
#    edges in the log (a user process's console line carries no timestamp, the kernel's do);
#  - etc/rc.drive: one rwtouch line per gesture burst, no trailing backslash (the runner that
#    reads the file splits on blanks and passes at most 63 arguments), and no /bin/sleep
#    (this image has none -- the first version of that list ended at boot+3s).
#
# CAUTION, measured this round: images built with rc.drive panicked 4 cold boots out of 4
# (Ticket spinlock timeout, or lsd spinning on the CPU monitor) while the same kernel with
# the plain rc.vtop passed 5 of 5.  The touch path is the next thing to make stable; until
# then R1's boots use rc.vtop.

diff --git a/userland/src/rwtouch.c b/userland/src/rwtouch.c
index 376269d..951b805 100644
--- a/userland/src/rwtouch.c
+++ b/userland/src/rwtouch.c
@@ -209,6 +209,12 @@ main(int argc, char **argv)
 			drag(atof(argv[i + 1]), atof(argv[i + 2]), atof(argv[i + 3]), atof(argv[i + 4]), atoi(argv[i + 5]),
 			    atoi(argv[i + 6]), grab);
 			i += grab ? 7 : 6;
+		} else if (strcmp(step, "mark") == 0 && left >= 1) {
+			/* a line of our own on the console, so that a measurement window has edges in the
+			 * log (the kernel stamps console lines with the seconds since boot) */
+			printf("rwtouch: mark %s\n", argv[i + 1]);
+			fflush(stdout);
+			i += 1;
 		} else if (strcmp(step, "notify") == 0 && left >= 1) {
 			uint32_t status = notify_post(argv[i + 1]);
 
--- /dev/null
