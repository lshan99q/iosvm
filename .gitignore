# Apple content, images and firmware — never committed
firmware/
userland/
userland-raw/
*.ipsw
*.dmg
bootkc
dtree
*.apfs
*.tc
*.im4p
*.im4m

# Device firmware
fw-*/

# Build products
build/
out/
*.o
*.a
*.dylib
*.so
*.efi
payload.bin

# The QEMU fork is a submodule; its work tree is not tracked here
qemu/*
!qemu/.git
!qemu/README.md

# Logs and ad-hoc screenshots. Acceptance captures live in docs/demo/ and are tracked.
logs/
*.log
docs/demo/**/scratch*

# Local configuration
.env
.env.*
*.local.conf
.vscode/
.idea/
.DS_Store

# Scratch
tools/scratch/
*.swp
*~
__pycache__/
*.pyc

# Host build products: sources are in the tree, the binaries are not (provenance rule 4)
tools/glwire/frame_replay
tools/glwire/host_glwire
tools/glwire/map_test
tools/host-glquad/gpu_host
tools/host-glquad/gpu_host_ram
tools/host-glquad/rammap
.scion/
